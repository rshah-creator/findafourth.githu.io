{
  "expo": {
    "name": "Find a Fourth",
    "slug": "find-a-fourth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3EFFE"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.razaushah.findafourth",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Find a Fourth notifies you when players join your game, games are cancelled, and when it's time to rate your round.",
        "NSPhotoLibraryUsageDescription": "Find a Fourth uses your photo library to let you set a profile picture.",
        "NSCameraUsageDescription": "Find a Fourth uses your camera to take a profile picture.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3EFFE"
      },
      "package": "com.findafourth.app",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EFFE",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#7B4FD4",
          "iosDisplayInForeground": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "findafourth",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "581f0fe8-db20-4678-a9e3-302c410c8a03"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/581f0fe8-db20-4678-a9e3-302c410c8a03"
    }
  }
}
